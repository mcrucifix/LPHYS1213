
#include "epix.h"
#include "stdio.h"
using namespace ePiX;



int main() {

  char str_buffer[5];

  bounding_box(P(-1.2,-1.5), P(1.2,1.5));
  picture(2.4,3);
  unitlength("90pt");

  begin();
 
  dot(P(0,0));
  degrees();
  /* SOURCE potential flow */

  /* stream function */
  for (double theta = 0; theta < 360; theta += 30){
        arrow(polar(0.1, theta), polar(0.4, theta));
        line(polar(0.4, theta), polar(0.7, theta));
        sprintf(str_buffer, "%.f", theta);
        label(polar(0.8, theta+5), P(0,0), str_buffer, c);
        sprintf(str_buffer, "%.f", theta + 360);
        if (theta < 120) {
        label_color(Blue(1.0));
        sprintf(str_buffer, "%.f", theta + 360);
        label(polar(1.0, theta+5), P(0,0), str_buffer, c);
        } else if (theta < 150) {
        label_color(Blue(1.0));
        label(polar(1.0, theta+10), P(0,0), "...", c);
        }
        label_color(Black(1.0));
    }

  /* potential velocity */
    plain(Red(0.7));
  dashed();
  for (double lnr=-2 ; lnr< 0 ; lnr += 0.5){
       circle(P(0,0), exp(lnr));
    }
  solid();

  plain(Black(0.4));
  label_color(Black(0.4));
  arrow(P(0,0), P(1,0));  label(P(1,0), P(10, 0), "Re", c);
  arrow(P(0,0), P(0,1));  label(P(0,1), P( 0, 10), "Im", c);
  tikz_format();

  end();
}
